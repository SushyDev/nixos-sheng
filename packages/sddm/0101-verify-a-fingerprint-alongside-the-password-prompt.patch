+            fingerprintSession = stateConfig.Last.Session.get();
+        if (findSessionEntry(mainConfig.Wayland.SessionDir.get(), fingerprintSession)) {
+            sessionType = Session::WaylandSession;
+        } else if (findSessionEntry(mainConfig.X11.SessionDir.get(), fingerprintSession)) {
+            sessionType = Session::X11Session;
+        } else {
+            qCritical() << "Unable to find fingerprint session entry" << fingerprintSession;
+            return false;
+        }
+
+        Session session;
+        session.setTo(sessionType, fingerprintSession);
+
+        qDebug() << "Verifying a fingerprint for" << user;
+
+        return startAuth(m_fingerprintAuth, user, QString(), session);
