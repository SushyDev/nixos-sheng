+        QString user = mainConfig.Fingerprint.User.get();
+        if (user.isEmpty())
+            user = stateConfig.Last.User.get();
+        if (user.isEmpty()) {
+            qDebug() << "No user to verify a fingerprint against";
+            return false;
+        }
+
+        Session::Type sessionType = Session::X11Session;
+
+        QString fingerprintSession = mainConfig.Fingerprint.Session.get();
