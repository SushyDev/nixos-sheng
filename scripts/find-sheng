# Print a host that reaches the sheng. Tries mDNS, then the cached address,
# then sweeps the /24 for images too old to publish a name or hold an address.

# Dev files (key, ip cache) live at the project root, not necessarily $PWD.
sheng_root() {
  local dir="$PWD"
  local _
  for _ in 1 2 3 4; do
    [ -e "$dir/sheng-devkey" ] && { echo "$dir"; return 0; }
    dir="$(dirname "$dir")"
  done
  echo "$PWD"
}
ROOT="$(sheng_root)"
readonly ROOT
readonly IP_CACHE="${SHENG_IP_CACHE:-$ROOT/.sheng-ip}"
readonly KEY="${SHENG_KEY:-$ROOT/sheng-devkey}"

ssh_opts=(
  -i "$KEY"
  -o IdentitiesOnly=yes
  -o BatchMode=yes
  -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null
  -o ConnectTimeout=3
  -o LogLevel=ERROR
)

is_sheng() {
  local -r host="$1"
  ssh "${ssh_opts[@]}" "root@$host" 'test -e /dev/disk/by-partlabel/boot_a' 2>/dev/null
}

# Only the device answers to its own published name, so reaching sshd on it is
# proof enough of identity. That skips is_sheng, and with it the dependency on
# a key that a userdata reflash wipes.
try_mdns() {
  nc -z -G 1 -w 1 sheng.local 22 >/dev/null 2>&1 || return 1
  echo sheng.local
}

try_cache() {
  [ -f "$IP_CACHE" ] || return 1
  local -r cached="$(cat "$IP_CACHE")"
  [ -n "$cached" ] || return 1
  is_sheng "$cached" || return 1
  echo "$cached"
}

sweep() {
  local -r prefix="${1%.*}"
  local -r hits="$(mktemp)"
  local host i
  local -a candidates

  for i in $(seq 2 254); do
    ( nc -z -G 1 -w 1 "$prefix.$i" 22 >/dev/null 2>&1 && echo "$prefix.$i" >>"$hits" ) &
  done
  wait

  mapfile -t candidates <"$hits"
  rm -f "$hits"

  for host in "${candidates[@]}"; do
    is_sheng "$host" || continue
    echo "$host" >"$IP_CACHE"
    echo "$host"
    return 0
  done

  return 1
}

try_mdns && exit 0
try_cache && exit 0
sweep "$(ipconfig getifaddr en0 2>/dev/null || echo 192.168.2.1)"
