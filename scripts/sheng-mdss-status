# Decode U-Boot's per-stage display bring-up status from the device.
#
# Run after a boot that showed backlight but no picture. U-Boot writes one
# slot per stage and relays them into /chosen.
#
#   0           stage succeeded
#   0x7fffffff  stage never reached
#   anything    -errno from that stage

readonly KEY="${SHENG_KEY:-$PWD/sheng-devkey}"
readonly NEVER_REACHED=2147483647

readonly STAGES=(
  MDSS_RESET GDSC BCM_MM0 DISPCC DSI0_PHY DSI1_PHY
  DSI_PHY_START DSI_LINK_CLKS DSI_PANEL DPU PROBE
)

ssh_opts=(
  -i "$KEY"
  -o IdentitiesOnly=yes
  -o BatchMode=yes
  -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null
  -o ConnectTimeout=5
  -o LogLevel=ERROR
)

die() {
  echo "$*" >&2
  exit 1
}

IP="$(find-sheng)" || die "device not found"
readonly IP

# Args are expanded locally before being sent, which is what callers want.
# shellcheck disable=SC2029
dev() {
  ssh "${ssh_opts[@]}" "root@$IP" "$@"
}

raw="$(dev 'od -An -v -tx4 --endian=big /proc/device-tree/chosen/sheng,mdss-status 2>/dev/null || true')"
[ -n "${raw// /}" ] || die "no sheng,mdss-status property"

describe() {
  local -r word="$1"
  local value=$((16#$word))

  # Slots hold a signed int.
  [ "$value" -ge 2147483648 ] && value=$((value - 4294967296))

  case "$value" in
    0) echo ok ;;
    "$NEVER_REACHED") echo "not reached" ;;
    *) echo "FAILED ($value)" ;;
  esac
}

echo "device $IP"
echo

first_failure=""
i=0
for word in $raw; do
  [ "$i" -lt "${#STAGES[@]}" ] || break

  status="$(describe "$word")"
  printf '  %-16s %s\n' "${STAGES[$i]}" "$status"

  case "$status" in
    FAILED*) [ -n "$first_failure" ] || first_failure="${STAGES[$i]}" ;;
  esac
  i=$((i + 1))
done

echo
if [ -n "$first_failure" ]; then
  echo "first failing stage: $first_failure"
else
  echo "all stages ok -- a blank panel means the fault is after probe"
fi
