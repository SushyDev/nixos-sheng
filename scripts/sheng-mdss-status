# Decode U-Boot's per-stage display bring-up status, relayed into /chosen.
# Run after a boot that showed backlight but no picture.
#
#   0           stage succeeded
#   0x7fffffff  stage never reached
#   anything    -errno from that stage

# Dev files (key, ip cache) live at the project root, not necessarily $PWD.
sheng_root() {
  local dir="$PWD"
  local _
  for _ in 1 2 3 4; do
    [ -e "$dir/sheng-devkey" ] && { echo "$dir"; return 0; }
    dir="$(dirname "$dir")"
  done
  echo "$PWD"
}
ROOT="$(sheng_root)"
readonly ROOT
readonly KEY="${SHENG_KEY:-$ROOT/sheng-devkey}"
readonly NEVER_REACHED=2147483647

readonly STAGES=(
  MDSS_RESET GDSC BCM_MM0 DISPCC DSI0_PHY DSI1_PHY
  DSI_PHY_START DSI_LINK_CLKS DSI_PANEL DPU PROBE
)

ssh_opts=(
  -i "$KEY"
  -o IdentitiesOnly=yes
  -o BatchMode=yes
  -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null
  -o ConnectTimeout=5
  -o LogLevel=ERROR
)

die() {
  echo "$*" >&2
  exit 1
}

IP="$(find-sheng)" || die "device not found"
readonly IP

# shellcheck disable=SC2029
dev() {
  ssh "${ssh_opts[@]}" "root@$IP" "$@"
}

raw="$(dev 'od -An -v -tx4 --endian=little /proc/device-tree/chosen/sheng,mdss-status 2>/dev/null || true')"
[ -n "${raw// /}" ] || die "no sheng,mdss-status property"

describe() {
  local -r word="$1"
  local value=$((16#$word))

  # Slots hold a signed int.
  [ "$value" -ge 2147483648 ] && value=$((value - 4294967296))

  case "$value" in
    0) echo ok ;;
    "$NEVER_REACHED") echo "not reached" ;;
    *) echo "FAILED ($value)" ;;
  esac
}

echo "device $IP"
echo

first_failure=""
reached=0
i=0
for word in $raw; do
  [ "$i" -lt "${#STAGES[@]}" ] || break

  status="$(describe "$word")"
  printf '  %-16s %s\n' "${STAGES[$i]}" "$status"

  case "$status" in
    FAILED*) [ -n "$first_failure" ] || first_failure="${STAGES[$i]}" ;;
    ok) reached=$((reached + 1)) ;;
  esac
  i=$((i + 1))
done

echo
if [ -n "$first_failure" ]; then
  echo "first failing stage: $first_failure"
elif [ "$reached" -le 1 ]; then
  echo "inherited ABL's live display; cold bring-up was skipped"
else
  echo "all stages ok -- a blank panel means the fault is after probe"
fi
