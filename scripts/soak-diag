#!/usr/bin/env bash
# Reboot repeatedly and log U-Boot's FULL display signature each time.
#
# WHY THIS EXISTS, when soak.sh already reboots in a loop: soak.sh checks
# the 11 mdss-status stage codes, and those CANNOT see the failure we are
# chasing. A visibly corrupted boot still reports every stage 0 -- and if
# the probe failed and was silently retried, the retry overwrites the
# stage array with its own success. soak.sh called 6/6 boots clean while
# the panel was visibly glitching.
#
# This logs sheng,display-diag instead, which carries the things that can
# actually discriminate:
#
#   probes=            2 means probe #1 failed and qcom_late_init()
#                      silently re-ran the whole thing on a half-init panel
#   panel_init_first=  the FIRST attempt's error, before the retry masks it.
#                      -(10000+idx) names the init-table command index;
#                      -20001..-20007 are the DSC tail / sleep-out /
#                      display-on stages
#   pm_val=            what the DDIC says it is doing. 9c = correctly
#                      initialised, 08 = sleep-in/display-off, init did not
#                      take. Only trust it when the pm= field's 31:16 half
#                      reads 01f7 (CMD_MODE_EN asserted, BTA really issued)
#   fifo_late=         00001210 is healthy, matching rendering Linux
#   collapse_us=       -1 means the MDSS GDSC never collapsed
#
# Usage: ./soak-diag.sh [count] [logfile]
set -uo pipefail
set -f
HERE="$(cd "$(dirname "$0")" && pwd)"
KEY="${SHENG_KEY:-$HERE/sheng-devkey}"
O=(-i "$KEY" -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=no
   -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 -o LogLevel=ERROR)
N=${1:-15}
LOG=${2:-$HERE/soak-diag.log}

echo "# soak-diag $(date -u +%FT%TZ), $N boots" | tee -a "$LOG"

for n in $(seq 1 "$N"); do
  IP=""
  for t in $(seq 1 24); do IP=$("$HERE/find-sheng.sh" 2>/dev/null) && break; sleep 5; done
  if [ -z "$IP" ]; then
    echo "boot $n: DEVICE DID NOT RETURN" | tee -a "$LOG"
    continue
  fi

  DIAG=$(ssh "${O[@]}" "root@$IP" \
    'cat /proc/device-tree/chosen/sheng,display-diag 2>/dev/null; echo' 2>/dev/null)
  TAG=$(ssh "${O[@]}" "root@$IP" \
    'tr " " "\n" < /proc/cmdline | grep -o "sheng.b=[0-9]*"' 2>/dev/null)

  echo "boot $n: $TAG $DIAG" | tee -a "$LOG"

  [ "$n" = "$N" ] && break
  ssh "${O[@]}" "root@$IP" 'sync; (sleep 1; systemctl reboot) >/dev/null 2>&1 &' >/dev/null 2>&1
  rm -f "$HERE/.sheng-ip"
  sleep 25
done

echo "# --- summary ---" | tee -a "$LOG"
grep -o 'pm_val=[0-9a-f]*' "$LOG" | sort | uniq -c | tee -a "$LOG"
grep -o 'probes=[0-9]*' "$LOG" | sort | uniq -c | tee -a "$LOG"
grep -o 'panel_init_first=-\?[0-9]*' "$LOG" | sort | uniq -c | tee -a "$LOG"
