# Drive the aarch64-linux Docker builder.
#
# Determinate's native Linux builder has no network, so fixed-output
# derivations cannot fetch in it. This container can.
#
# Everything goes over `docker exec`: no exposed port, no sshd, no keys.
# The flake is bind-mounted read-only at /workspace.
#
# Usage:
#   builder up                 start it
#   builder down               stop it
#   builder status             container state and store size
#   builder build <attr>       build an attr, print its store path
#   builder fetch <attr> [dir] build it and copy the result out

readonly DIR="${SHENG_DOCKER_DIR:-./docker}"
readonly NAME=sheng-builder
readonly FLAKE=/workspace
readonly SYSTEM=aarch64-linux

die() {
  echo "$*" >&2
  exit 1
}

compose() {
  docker compose -f "$DIR/compose.yaml" "$@"
}

in_builder() {
  docker exec "$NAME" /root/.nix-profile/bin/bash -c "$*"
}

require_running() {
  docker ps --filter "name=$NAME" --format '{{.Names}}' | grep -qx "$NAME" ||
    die "$NAME is not running -- try: builder up"
}

# Prints the store path on the last line; build chatter goes to stderr so
# callers can capture it cleanly.
build() {
  local -r attr="${1:?usage: builder build <attr>}"
  require_running
  in_builder "nix build --print-out-paths --print-build-logs \
    '$FLAKE#packages.$SYSTEM.$attr'"
}

# Streamed as a tar rather than `docker cp`: store paths are read-only,
# and cp recreates those modes as it goes, then cannot write into the
# directory it just made.
fetch() {
  local -r attr="${1:?usage: builder fetch <attr> [dir]}"
  local -r dest="${2:-./result}"
  local path

  path="$(build "$attr" | tail -1)" || die "build failed"
  [ -n "$path" ] || die "build produced no output path"

  # Deliberately NOT `rm -rf "$dest"`. Both artifacts land in ./result --
  # that is where fastboot-flash and flash-rootfs look by default -- and
  # they come from two different attrs, so wiping the destination made
  # `fetch u-boot && fetch nixos` silently delete boot.img. Extracting over
  # the top can leave a stale file behind if a derivation stops emitting
  # one; that is the lesser problem, and `rm -rf ./result` is right there.
  mkdir -p "$dest"
  docker exec "$NAME" tar -C "$path" -cf - . |
    tar -xf - -C "$dest" --no-same-permissions
  chmod -R u+w "$dest"
  echo "$dest"
}

status() {
  compose ps
  require_running
  in_builder 'nix --version; ls /nix/store | wc -l'
}

case "${1:-up}" in
  up) compose up -d ;;
  down) compose down ;;
  status) status ;;
  build) shift && build "$@" ;;
  fetch) shift && fetch "$@" ;;
  *) die "usage: builder [up|down|status|build <attr>|fetch <attr> [dir]]" ;;
esac
