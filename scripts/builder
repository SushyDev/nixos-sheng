# Drive the aarch64-linux Docker builder. Determinate's native Linux builder
# has no network, so fixed-output derivations cannot fetch in it.
#
# Usage:
#   builder up                 start it
#   builder down               stop it
#   builder status             container state and store size
#   builder build <attr>       build an attr, print its store path
#   builder fetch <attr> [dir] build it and copy the result out

readonly DIR="${SHENG_DOCKER_DIR:-./docker}"
readonly NAME=sheng-builder
readonly FLAKE=/workspace
readonly SYSTEM=aarch64-linux

die() {
  echo "$*" >&2
  exit 1
}

compose() {
  docker compose -f "$DIR/compose.yaml" "$@"
}

in_builder() {
  docker exec "$NAME" /root/.nix-profile/bin/bash -c "$*"
}

require_running() {
  docker ps --filter "name=$NAME" --format '{{.Names}}' | grep -qx "$NAME" ||
    die "$NAME is not running -- try: builder up"
}

build() {
  local -r attr="${1:?usage: builder build <attr>}"
  require_running
  in_builder "nix build --print-out-paths --print-build-logs \
    '$FLAKE#packages.$SYSTEM.$attr'"
}

# Streamed as a tar rather than `docker cp`, which recreates the store's
# read-only modes as it goes and then cannot write into its own directory.
fetch() {
  local -r attr="${1:?usage: builder fetch <attr> [dir]}"
  local -r dest="${2:-./result}"
  local path

  path="$(build "$attr" | tail -1)" || die "build failed"
  [ -n "$path" ] || die "build produced no output path"

  # Deliberately NOT `rm -rf "$dest"`: both artifacts land in ./result from
  # different attrs, so wiping it made `fetch u-boot && fetch nixos` delete
  # boot.img. A stale file left behind is the lesser problem.
  mkdir -p "$dest"
  docker exec "$NAME" tar -C "$path" -cf - . |
    tar -xf - -C "$dest" --no-same-permissions
  chmod -R u+w "$dest"
  echo "$dest"
}

status() {
  compose ps
  require_running
  in_builder 'nix --version; ls /nix/store | wc -l'
}

case "${1:-up}" in
  up) compose up -d ;;
  down) compose down ;;
  status) status ;;
  build) shift && build "$@" ;;
  fetch) shift && fetch "$@" ;;
  *) die "usage: builder [up|down|status|build <attr>|fetch <attr> [dir]]" ;;
esac
