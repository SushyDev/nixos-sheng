# Bring up the aarch64-linux Docker builder.
#
# Determinate's native Linux builder has no network, so fixed-output
# derivations cannot fetch in it. This container can.
#
# Usage: builder [up|down|status|machines]

readonly DIR="${SHENG_DOCKER_DIR:-./docker}"
readonly KEY="${SHENG_BUILDER_KEY:-$HOME/.ssh/sheng-builder}"
readonly PORT="${SHENG_BUILDER_PORT:-2222}"

die() {
  echo "$*" >&2
  exit 1
}

compose() {
  docker compose -f "$DIR/compose.yaml" "$@"
}

ensure_key() {
  [ -f "$KEY" ] && return 0
  echo "generating $KEY"
  ssh-keygen -t ed25519 -N '' -C sheng-builder -f "$KEY" >/dev/null
}

# compose bind-mounts this read-only into the container.
ensure_authorized_keys() {
  cp "$KEY.pub" "$DIR/authorized_keys"
}

# nix.conf reads `builders = @/etc/nix/machines`. Fields are:
# uri system sshKey maxJobs speedFactor features mandatoryFeatures hostKey
machines_line() {
  echo "ssh-ng://root@127.0.0.1:$PORT aarch64-linux $KEY 8 1 big-parallel,benchmark - -"
}

up() {
  ensure_key
  ensure_authorized_keys
  SHENG_BUILDER_PORT="$PORT" compose up -d
  echo
  echo "add to /etc/nix/machines to let nix offload to it:"
  echo "  $(machines_line)"
}

status() {
  SHENG_BUILDER_PORT="$PORT" compose ps
  ssh -i "$KEY" -p "$PORT" \
    -o IdentitiesOnly=yes -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10 \
    root@127.0.0.1 'nix --version; df -h /nix | tail -1' 2>&1 ||
    die "cannot reach builder on port $PORT"
}

case "${1:-up}" in
  up) up ;;
  down) SHENG_BUILDER_PORT="$PORT" compose down ;;
  status) status ;;
  machines) machines_line ;;
  *) die "usage: builder [up|down|status|machines]" ;;
esac
