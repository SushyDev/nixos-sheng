# Reboot repeatedly and check U-Boot's display bring-up after each boot.
# Catches the intermittent "backlight, no picture" case without anyone
# watching the panel.
#
# Usage: soak [count]

readonly COUNT="${1:-15}"
# Dev files (key, ip cache) live at the project root, which is not
# necessarily $PWD -- the flake is a subdirectory. Search upward.
sheng_root() {
  local dir="$PWD"
  local _
  for _ in 1 2 3 4; do
    [ -e "$dir/sheng-devkey" ] && { echo "$dir"; return 0; }
    dir="$(dirname "$dir")"
  done
  echo "$PWD"
}
ROOT="$(sheng_root)"
readonly ROOT
readonly KEY="${SHENG_KEY:-$ROOT/sheng-devkey}"
readonly IP_CACHE="${SHENG_IP_CACHE:-$ROOT/.sheng-ip}"

# One slot per bring-up stage, in the order sheng_mdss writes them.
readonly STAGES=(
  MDSS_RESET GDSC BCM_MM0 DISPCC DSI0_PHY DSI1_PHY
  DSI_PHY_START DSI_LINK_CLKS DSI_PANEL DPU PROBE
)

ssh_opts=(
  -i "$KEY"
  -o IdentitiesOnly=yes
  -o BatchMode=yes
  -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null
  -o ConnectTimeout=5
  -o LogLevel=ERROR
)

# The device takes a new DHCP lease every boot, so rediscover each time.
wait_for_device() {
  local ip _

  for _ in $(seq 1 24); do
    ip="$(find-sheng 2>/dev/null)" && { echo "$ip"; return 0; }
    sleep 5
  done
  return 1
}

# Nonzero in any slot means that stage failed.
failed_stages() {
  local -r ip="$1"
  local raw word bad="" i=0

  raw="$(ssh "${ssh_opts[@]}" "root@$ip" \
    'od -An -v -tx4 --endian=little /proc/device-tree/chosen/sheng,mdss-status 2>/dev/null')"

  for word in $raw; do
    [ "$i" -lt "${#STAGES[@]}" ] || break
    [ "$word" = 00000000 ] || bad="$bad ${STAGES[$i]}=0x$word"
    i=$((i + 1))
  done

  echo "$bad"
}

reboot_device() {
  local -r ip="$1"
  ssh "${ssh_opts[@]}" "root@$ip" \
    'sync; (sleep 1; systemctl reboot) >/dev/null 2>&1 &' >/dev/null 2>&1 || true
  rm -f "$IP_CACHE"
  sleep 25
}

for n in $(seq 1 "$COUNT"); do
  if ! ip="$(wait_for_device)"; then
    echo "boot $n: device did not return"
    continue
  fi

  bad="$(failed_stages "$ip")"
  if [ -n "$bad" ]; then
    echo "boot $n: FAILURE$bad"
  else
    echo "boot $n: all stages ok"
  fi

  [ "$n" = "$COUNT" ] && break
  reboot_device "$ip"
done
